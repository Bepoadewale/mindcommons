{
  "name": "mindcommons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open-source prototype for community governance of AI research.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npm run build && npm run db:migrate:local && npm run worker:dev",
    "build:vision": "VITE_BASE_PATH=/mindcommons/ VITE_VISION_ONLY=true npm run build",
    "test:vision-static": "npm run build:vision && playwright test --config playwright.vision.config.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:agreement": "vitest run tests/agreement-conformance.test.ts tests/community-ai-agreement.test.ts tests/portable-ai-service.test.ts tests/decision-receipt.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "demo:record": "node scripts/record-live-demo.mjs",
    "test:integration": "node scripts/test-local-integration.mjs",
    "agreement:schema": "node --experimental-strip-types scripts/export-agreement-schema.ts",
    "test:e2e:fullstack": "node scripts/test-local-browser.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run build:vision && node scripts/validate-vision-build.mjs && npm run build && npm run db:migrate:local && npm run test:integration && node scripts/validate-docs.mjs",
    "worker:dev": "wrangler dev --local --ip 127.0.0.1 --port 8788 --var DEMO_AI_MODE:mock --var LOCAL_DEVELOPMENT:true",
    "db:migrate:local": "wrangler d1 migrations apply mindcommons-demo-d1 --local",
    "db:migrate:remote": "wrangler d1 migrations apply mindcommons-demo-d1 --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261116.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.163.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
