{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "agreementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "communityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "policyVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "superseded"]
    },
    "effectiveAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "permittedPurposes": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "community-wellbeing-research",
          "community-access-research",
          "commercial-advertising"
        ]
      }
    },
    "authorizedResearcherIds": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "commercialUseAllowed": {
      "type": "boolean"
    },
    "withdrawalMode": {
      "type": "string",
      "enum": ["exclude-withdrawn", "require-all"]
    },
    "contributions": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contributionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "contributorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "purpose": {
            "type": "string",
            "enum": [
              "community-wellbeing-research",
              "community-access-research",
              "commercial-advertising"
            ]
          },
          "permission": {
            "type": "object",
            "properties": {
              "purpose": {
                "type": "string",
                "enum": [
                  "community-wellbeing-research",
                  "community-access-research",
                  "commercial-advertising"
                ]
              },
              "status": {
                "type": "string",
                "enum": ["granted", "withdrawn", "expired"]
              },
              "version": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": ["purpose", "status", "version", "expiresAt"],
            "additionalProperties": false
          }
        },
        "required": ["contributionId", "contributorId", "purpose", "permission"],
        "additionalProperties": false
      }
    },
    "modelUse": {
      "type": "object",
      "properties": {
        "allowedModelIds": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "allowedJobTypes": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "trainingAllowed": {
          "type": "boolean"
        },
        "publicOutputsAllowed": {
          "type": "boolean"
        },
        "clinicalUseAllowed": {
          "type": "boolean"
        }
      },
      "required": [
        "allowedModelIds",
        "allowedJobTypes",
        "trainingAllowed",
        "publicOutputsAllowed",
        "clinicalUseAllowed"
      ],
      "additionalProperties": false
    },
    "benefitObligations": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "obligationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "accountableParty": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "dueAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "status": {
            "type": "string",
            "enum": ["proposed", "agreed", "accepted", "evidence-recorded", "community-reviewed"]
          },
          "agreedByCommunity": {
            "type": "boolean"
          },
          "acceptedByResearchTeam": {
            "type": "boolean"
          }
        },
        "required": [
          "obligationId",
          "description",
          "accountableParty",
          "dueAt",
          "status",
          "agreedByCommunity",
          "acceptedByResearchTeam"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "agreementId",
    "communityId",
    "policyVersion",
    "status",
    "effectiveAt",
    "permittedPurposes",
    "authorizedResearcherIds",
    "commercialUseAllowed",
    "withdrawalMode",
    "contributions",
    "modelUse",
    "benefitObligations"
  ],
  "additionalProperties": false
}
