{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mindcommons-mozilla-demo",
  "account_id": "1630257815c70704ad812cd52c284ca2",
  "main": "./functions/worker.ts",
  "workers_dev": true,
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mindcommons-demo-d1",
      "database_id": "9b9dff3c-6743-4dab-8fb9-e2cebe0196f0",
      "migrations_dir": "database/migrations",
    },
  ],
  "ai": {
    "binding": "AI",
  },
}
